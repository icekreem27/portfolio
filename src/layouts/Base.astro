---
import '../styles/global.css';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  current?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  ld?: Record<string, unknown>;
}
const { title = site.title, description = site.description, current, type = 'website', noindex = false, ld } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t); } catch (e) {}
    </script>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Karim Abbas, Data & AI engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <noscript><style>.rise { opacity: 1 !important; transform: none !important; }</style></noscript>
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav" data-nav>
      <div class="wrap nav-in">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/#work" aria-current={current === 'work' ? 'page' : undefined}>Work</a>
          <a href="/#about">About</a>
          <a href="/#research">Publications</a>
          <a href={site.links.cv}>CV</a>
          <a class="btn" href={site.links.email}>Get in touch</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch colour theme" title="Switch theme">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="wrap foot">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <nav aria-label="Elsewhere">
          <a class="tlink" href={site.links.github} >GitHub</a>
          <a class="tlink" href={site.links.linkedin} >LinkedIn</a>
          <a class="tlink" href={site.links.email}>{site.email}</a>
        </nav>
      </div>
    </footer>
    <script>
      document.querySelectorAll('a[href]').forEach((a) => {
        const h = a.getAttribute('href') || '';
        if (!/^https?:\/\//.test(h) || h.startsWith(location.origin)) return;
        a.setAttribute('target', '_blank');
        a.setAttribute('rel', 'noopener noreferrer');
      });
      const root = document.documentElement;
      const isDark = () => root.getAttribute('data-theme') === 'dark' || (!root.getAttribute('data-theme') && matchMedia('(prefers-color-scheme: dark)').matches);
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.classList.add('theme-anim');
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        setTimeout(() => root.classList.remove('theme-anim'), 450);
      });
      const nav = document.querySelector('[data-nav]');
      const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
      document.querySelectorAll('.rise').forEach((el) => io.observe(el));
      const links = [...document.querySelectorAll('.toc a')];
      if (links.length) {
        const so = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.getAttribute('href') === '#' + e.target.id));
        }), { rootMargin: '-20% 0px -70% 0px' });
        links.forEach((a) => { const t = document.querySelector(a.getAttribute('href')!); if (t) so.observe(t); });
      }
    </script>
  </body>
</html>
